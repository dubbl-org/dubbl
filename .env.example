# =============================================================================
# Dubbl — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# If using Docker Compose, these defaults work out of the box.

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# For Docker Compose: postgresql://dubbl:dubbl@localhost:5432/dubbl
DATABASE_URL="postgresql://dubbl:dubbl@localhost:5432/dubbl"

# -----------------------------------------------------------------------------
# Authentication — NextAuth (Required)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="local-dev-secret-change-me-in-production"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# OAuth Providers (Optional)
# -----------------------------------------------------------------------------
# Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple — https://developer.apple.com/sign-in-with-apple
# Option A (recommended): provide your .p8 key as base64 for runtime JWT generation
#   To encode: base64 -w0 AuthKey_XXXXXXXXXX.p8
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_KEY_BASE64=""
# Option B: provide a pre-generated JWT secret (expires after 6 months)
# AUTH_APPLE_SECRET=""

# -----------------------------------------------------------------------------
# Stripe (Optional — needed for billing features)
# -----------------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Plan price IDs from your Stripe product catalog (one flat price per organization).
# STRIPE_PRO_PRICE_ID / STRIPE_PRO_ANNUAL_PRICE_ID are still read as a fallback for Standard.
STRIPE_STANDARD_PRICE_ID=""
STRIPE_STANDARD_ANNUAL_PRICE_ID=""
STRIPE_PREMIUM_PRICE_ID=""
STRIPE_PREMIUM_ANNUAL_PRICE_ID=""
STRIPE_ULTIMATE_PRICE_ID=""
STRIPE_ULTIMATE_ANNUAL_PRICE_ID=""

# Stripe Connect (Optional — needed for user Stripe account integration)
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Exchange rates (Optional)
# -----------------------------------------------------------------------------
# Auto exchange-rate sync uses ExchangeRate-API's free open endpoint by default
# (open.er-api.com — no key, ~160 currencies, any base currency). No config
# needed for full multi-currency support.
#
# Optional: force ECB official rates (Frankfurter — ~31 majors, most
# authoritative for those). Leave unset to use the default.
# EXCHANGE_RATE_PROVIDER="frankfurter"
#
# Optional: use Open Exchange Rates instead (~200 currencies incl. crypto/metals).
# The free OXR plan is USD-base only, but other bases are triangulated from it,
# so any base currency still works. Requires an app id.
OPENEXCHANGERATES_APP_ID=""

# -----------------------------------------------------------------------------
# Email — Resend (Optional — needed for notification digests & platform emails)
# -----------------------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""
# Sender addresses (on a domain verified in your Resend account)
# RESEND_FROM="dubbl <noreply@dubbl.dev>"              # sign-in, invitations, notifications
# RESEND_DOCUMENTS_FROM="dubbl <invoices@dubbl.dev>"   # invoices, quotes, reminders

# -----------------------------------------------------------------------------
# Email — per-organization SMTP (Required to let organizations use their own mail server)
# -----------------------------------------------------------------------------
# 32-byte hex key that encrypts saved SMTP passwords. Generate with: openssl rand -hex 32
# Keep it: changing it makes saved SMTP passwords unreadable.
EMAIL_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Trigger.dev — Background jobs
# Optional for local development; required in production for scheduled tasks & retries.
# -----------------------------------------------------------------------------
TRIGGER_PROJECT_REF=""
TRIGGER_SECRET_KEY=""

# -----------------------------------------------------------------------------
# S3 / Object Storage (Optional — needed for file uploads)
# -----------------------------------------------------------------------------
# For Docker Compose (MinIO): use these defaults
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
# Address the browser uses for upload/download links, when it differs from
# S3_ENDPOINT (e.g. the app reaches MinIO as http://minio:9000 inside Docker)
# S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="dubbl"

# -----------------------------------------------------------------------------
# AI assistant — Tilly via OpenRouter (Optional — Tilly is off without a key)
# -----------------------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Any OpenRouter model id with tool calling. Default: openai/gpt-6-luna
# ASSISTANT_MODEL="openai/gpt-6-luna"
# Reasoning effort: minimal, low, medium (default) or high
# ASSISTANT_REASONING_EFFORT="medium"
# Point at a proxy or gateway instead of OpenRouter directly
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# -----------------------------------------------------------------------------
# Self-Hosting (Optional)
# -----------------------------------------------------------------------------
# REGISTRATION_MODE="open"          # open, invite_only, disabled
# ALLOWED_EMAIL_DOMAINS=""          # comma-separated: acme.com,example.com
